  FAILED
}

// ─── Lead Engine Models ──────────────────────────────────

model IcpProfile {
  id               String      @id @default(cuid())
  orgId            String
  org              Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name             String
  targetTitles     String[]
  targetIndustries String[]
  targetGeos       String[]
  minEmployees     Int?
  maxEmployees     Int?
  techStackSignals String[]
  intentKeywords   String[]
  seedDomains      String[]
  exclusionDomains String[]    @default([])
  scheduleEnabled  Boolean     @default(false)
  scheduleInterval Int         @default(24) // hours between runs
  lastRunAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  scrapeJobs       ScrapeJob[]

  @@index([orgId])
  @@index([scheduleEnabled, lastRunAt])
}

model Company {
  id             String   @id @default(cuid())
  orgId          String?
  org            Org?     @relation(fields: [orgId], references: [id], onDelete: SetNull)
  domain         String
  name           String
  industry       String?
  employeeRange  String?
  country        String?
  city           String?
  registryId     String?
  registrySource String?
  fundingStage   String?
  techStack      String[]
  atsProvider    String?
  atsSlug        String?
  teamPageUrl    String?
  raw            Json?
  confidence     Float    @default(0)
  intentScore    Int      @default(0)
  intentSignals  String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  people         Person[]

  @@unique([orgId, domain])
  @@index([domain])
  @@index([country])
  @@index([industry])
}

model Person {
  id            String           @id @default(cuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  title         String?
  seniority     Seniority        @default(UNKNOWN)
  department    Department       @default(UNKNOWN)
  linkedinSlug  String?
  linkedinUrl   String?
  githubHandle  String?
  twitterHandle String?
  location      String?
  bio           String?
  raw           Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  emails        EmailCandidate[]
  scores        LeadScore[]
  conversations Conversation[]

  @@index([companyId])
  @@index([linkedinSlug])
  @@index([seniority])
}

model EmailCandidate {
  id                 String             @id @default(cuid())
  personId           String
  person             Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  email              String
  pattern            String?
  source             EmailSource
  verified           Boolean            @default(false)
  verificationResult VerificationResult @default(UNKNOWN)
  confidence         Float              @default(0)
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())

  @@unique([personId, email])
  @@index([personId])
}

model PatternStore {
  id          String   @id @default(cuid())
  domain      String   @unique
  patterns    Json
  sampleSize  Int      @default(0)
  lastUpdated DateTime @default(now())
}

model LeadScore {
  id          String    @id @default(cuid())
  orgId       String
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  personId    String
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  score       Int       @default(0)
  breakdown   Json
  qualifiedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([orgId, personId])
  @@index([orgId])
  @@index([personId])
}

model ScrapeJob {
  id             String       @id @default(cuid())
  orgId          String
  org            Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  icpProfileId   String
  icpProfile     IcpProfile   @relation(fields: [icpProfileId], references: [id], onDelete: Cascade)
  stage          ScrapeStage
  status         ScrapeStatus @default(QUEUED)
  source         String?
  totalItems     Int          @default(0)
  processedItems Int          @default(0)
  failedItems    Int          @default(0)
  progress       Float        @default(0)
  metadata       Json?
  startedAt      DateTime?
  completedAt    DateTime?
  error          String?
  createdAt      DateTime     @default(now())

  @@index([orgId])
  @@index([stage])
  @@index([status])
}

// ─── LangGraph runtime ───────────────────────────────────
//
// GraphRun is the high-level run row the application reads from (status,
// current node, approval state, final output). LangGraph's own state for
// resumability lives in GraphCheckpoint / GraphCheckpointWrite, written via
// the PrismaCheckpointSaver (implements BaseCheckpointSaver).

model GraphRun {
  id                      String             @id @default(cuid())
  orgId                   String
  org                     Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  threadId                String             @unique
  graphName               String // e.g. "pipeline-supervisor"
  status                  GraphRunStatus     @default(RUNNING)
  currentNode             String?
  state                   Json? // last snapshot of public state (for the UI)
  // Durable canonical input for a first invocation. A worker checks for an
  // existing GraphCheckpoint before using this seed, so crash recovery never
  // re-seeds a thread that has already checkpointed.
  startIcpProfileIds      String[]           @default([])
  // The reviewer decision remains on the run until a worker successfully
  // drives it through LangGraph. `false` is a real pending rejection; null
  // means there is no pending resume command.
  pendingResumeApproved   Boolean?
  pendingResumeApprovedBy String?
  // Monotonic dispatch fence. Every resume/recovery increments this value;
  // BullMQ job ids include it so retained completed jobs cannot swallow a
  // later dispatch and stale jobs cannot drive a newer lifecycle phase.
  dispatchGeneration      Int                @default(0)
  needsApproval           Boolean            @default(false)
  approvedAt              DateTime?
  approvedBy              String?
  error                   String?
  startedAt               DateTime           @default(now())
  // Mutable worker/recovery activity clock. Keep startedAt immutable so run
  // dates and elapsed durations continue to describe the original run.
  lastActivityAt          DateTime           @default(now())
  completedAt             DateTime?
  // LangSmith root run id captured by whichever node makes the first traced
  // LLM call. Persisted (instead of held in an in-memory Map) so a graph that
  // crashes and resumes on a fresh pod can still post run-level feedback for
  // its earlier legs. Nullable: legacy rows and tracing-disabled envs leave it null.
  langsmithRootRunId      String?
  outreachArtifacts       OutreachArtifact[]

  @@index([orgId])
  @@index([status])
  @@index([status, lastActivityAt])
  @@index([orgId, startedAt])
}

model GraphCheckpoint {
  threadId            String
  checkpointNamespace String   @default("")
  checkpointId        String
  parentCheckpointId  String?
  type                String? // serde format hint ("json", "msgpack", etc)
  checkpoint          Bytes // serialized Checkpoint object
  metadata            Json?
  createdAt           DateTime @default(now())

  @@id([threadId, checkpointNamespace, checkpointId])
  @@index([threadId])
}

// No FK to GraphCheckpoint — LangGraph's PregelLoop can call putWrites with a
// checkpoint_id before put() persists that row (writes are scheduled for the
// upcoming step). A FK would reject those legitimate writes; deletion is
// handled by deleteThread() instead.
model GraphCheckpointWrite {
  threadId            String
  checkpointNamespace String   @default("")
  checkpointId        String
  taskId              String
  idx                 Int
  channel             String
  type                String?
  value               Bytes
  createdAt           DateTime @default(now())

  @@id([threadId, checkpointNamespace, checkpointId, taskId, idx])
  @@index([threadId])
  @@index([threadId, checkpointNamespace, checkpointId])
}

// Reviewable outreach payload generated by the outreach subgraph. Phase 2.5
// runs default to dry-run mode: artifacts are persisted in PENDING_REVIEW
// state and never delivered until a human approves them. The original
// dry-run payload is preserved in `payload` so reviewers see exactly what
// would have been sent; if approved, the worker sends and writes back a
// receipt + provider message id.
model OutreachArtifact {
  id                String                  @id @default(cuid())
  orgId             String
  org               Org                     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  graphRunId        String?
  graphRun          GraphRun?               @relation(fields: [graphRunId], references: [id], onDelete: SetNull)
  // Conversation linkage is optional for legacy/prospecting artifacts. New
  // email replies use first-class fields rather than burying provider routing
  // data in payload JSON. The composite relation prevents cross-org links.
  purpose           OutreachArtifactPurpose @default(OUTBOUND)
  conversationId    String?
  conversation      Conversation?           @relation(fields: [conversationId, orgId], references: [id, orgId], onDelete: NoAction)
  providerThreadId  String?
  replyToMessageId  String?
  replyToMessage    ConversationMessage?    @relation("ArtifactReplyToMessage", fields: [replyToMessageId, orgId], references: [id, orgId], onDelete: NoAction)
  // Tool that would have produced the external side effect (e.g. send_email).
  toolName          String
  channel           OutreachChannel
  // Identifies the recipient/account on the outbound side without forcing
  // a hard FK to Person/Company (the graph may produce artifacts for
  // not-yet-persisted leads).
  recipientRef      String?
  subject           String?
  bodyText          String?                 @db.Text
  bodyHtml          String?                 @db.Text
  // Verbatim tool args captured at the moment of the dry-run, so reviewers
  // see what would have been sent. The shape mirrors the tool's input.
  payload           Json
  status            OutreachArtifactStatus  @default(PENDING_REVIEW)
  // Free-text reason from the reviewer when rejecting.
  reviewerNote      String?
  reviewedBy        String?
  reviewedAt        DateTime?
  // Operational failure evidence is deliberately separate from reviewer
  // fields so retry exhaustion cannot be misreported as a human rejection.
  failureReason     String?
  failedAt          DateTime?
  // Set once the artifact is actually delivered. Together with sendReceiptId
  // these prove a real send happened post-approval.
  sentAt            DateTime?
  sendReceiptId     String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deliveredMessages ConversationMessage[]   @relation("DeliveredArtifactMessage")
  // PostgreSQL additionally owns the review-gated partial unique indexes
  // OutreachArtifact_one_reply_per_inbound_uniq and
  // OutreachArtifact_one_open_reply_per_conversation_uniq. Prisma 6 cannot
  // express their status predicates here; see the review-only 2026-08-12
  // expand migration.

  @@unique([id, orgId])
  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, purpose, status])
  @@index([graphRunId])
  @@index([orgId, createdAt])
  @@index([conversationId, createdAt])
  @@index([orgId, providerThreadId])
}

// Durable, org-scoped projection of a provider email thread. Provider IDs are
// always qualified by Integration so two connected mailboxes cannot collide.
// A conversation is created only after the store correlates the thread to a
// delivered outreach artifact; unrelated inbox mail is not materialized.
model Conversation {
  id                    String                         @id @default(cuid())
  orgId                 String
  org                   Org                            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  integrationId         String
  integration           Integration                    @relation(fields: [integrationId, orgId], references: [id, orgId], onDelete: NoAction)
  providerThreadId      String
  // Person has no orgId column in the legacy lead schema. ConversationStore
  // verifies Person.Company.orgId before setting this optional link.
  personId              String?
  person                Person?                        @relation(fields: [personId], references: [id], onDelete: SetNull)
  contactEmail          String
  contactName           String?
  subject               String                         @default("")
  lastMessagePreview    String                         @default("") @db.Text
  lastMessageAt         DateTime
  lastInboundAt         DateTime?
  lastOutboundAt        DateTime?
  unreadCount           Int                            @default(0)
  needsReply            Boolean                        @default(false)
  archivedAt            DateTime?
  sequenceStoppedAt     DateTime?
  sequenceStopReason    String?
  sentiment             ConversationSentiment?
  sentimentConfidence   Float?
  nextBestAction        String?                        @db.Text
  nextBestActionType    ConversationNextActionType?
  intelligenceStatus    ConversationIntelligenceStatus @default(PENDING)
  intelligenceError     String?                        @db.Text
  intelligenceUpdatedAt DateTime?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  messages              ConversationMessage[]
  followUpTasks         FollowUpTask[]
  outreachArtifacts     OutreachArtifact[]
  meetings              MeetingLedger[]

  @@unique([integrationId, providerThreadId])
  @@unique([id, orgId])
  @@index([orgId, archivedAt, lastMessageAt])
  @@index([orgId, needsReply, lastMessageAt])
  @@index([orgId, sentiment, lastMessageAt])
  @@index([orgId, personId])
}

// Immutable provider-message projection. Re-delivered Gmail history entries
// dedupe on (conversationId, providerMessageId); message bodies are stored,
// but raw MIME payloads and OAuth material are deliberately not retained.
model ConversationMessage {
  id                 String                @id @default(cuid())
  orgId              String
  org                Org                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversationId     String
  conversation       Conversation          @relation(fields: [conversationId, orgId], references: [id, orgId], onDelete: Cascade)
  direction          ConversationDirection
  providerMessageId  String
  internetMessageId  String?
  senderEmail        String
  senderName         String?
  toEmails           String[]
  ccEmails           String[]              @default([])
  subject            String                @default("")
  bodyText           String?               @db.Text
  bodyHtml           String?               @db.Text
  sentAt             DateTime
  readAt             DateTime?
  outreachArtifactId String?
  outreachArtifact   OutreachArtifact?     @relation("DeliveredArtifactMessage", fields: [outreachArtifactId, orgId], references: [id, orgId], onDelete: NoAction)
  replyArtifacts     OutreachArtifact[]    @relation("ArtifactReplyToMessage")
  sourceMeetings     MeetingLedger[]       @relation("MeetingSourceMessage")
  createdAt          DateTime              @default(now())

  @@unique([conversationId, providerMessageId])
  @@unique([id, orgId])
  @@unique([orgId, outreachArtifactId])
  @@index([orgId, sentAt])
  @@index([conversationId, sentAt])
  @@index([orgId, internetMessageId])
}

// V1 follow-ups are durable tasks/reminders, never autonomous send jobs. An
// inbound reply cancels only OPEN AGENT tasks; human-authored reminders remain
// under explicit operator control.
model FollowUpTask {
  id                 String         @id @default(cuid())
  orgId              String
  org                Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversationId     String
  conversation       Conversation   @relation(fields: [conversationId, orgId], references: [id, orgId], onDelete: Cascade)
  dueAt              DateTime
  note               String?        @db.Text
  status             FollowUpStatus @default(OPEN)
  source             FollowUpSource @default(HUMAN)
  createdBy          String?
  completedBy        String?
  completedAt        DateTime?
  cancelledBy        String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([id, orgId])
  @@index([orgId, status, dueAt])
  @@index([conversationId, status, dueAt])
}

// A versioned, declarative description of a multi-step workflow. The
// runtime resolves a slug+version to the canonical config (which graph to
// run, which inputs to expect, whether HITL is required). Templates are
// org-agnostic: a single seed row backs every tenant's runs.
model WorkflowTemplate {
  id               String   @id @default(cuid())
  // Stable identifier used by clients to start a workflow (e.g.
  // "tenant_zero_sdr_outreach_artifact_v1"). Unique across versions so a
  // v2 row is a separate template; older runs still resolve to v1.
  slug             String   @unique
  name             String
  description      String
  version          Int      @default(1)
  // Name of the graph the runtime should compile to execute this workflow
  // (currently always "pipeline-supervisor"; here so future templates can
  // target alternative graphs without a code change).
  graphName        String
  // Free-form config: input schema, defaults, HITL gates, feature flags.
  // Kept as JSON so the schema doesn't churn with every workflow.
  config           Json
  // Phase 2.5 templates set requiresApproval=true and produce review
  // artifacts only. A v2 release toggles this once policy allows.
  requiresApproval Boolean  @default(true)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  runs WorkflowRun[]

  @@index([slug])
  @@index([isActive])
}

// Concrete invocation of a WorkflowTemplate for one org. Maps 1:1 with the
// underlying GraphRun for runs that go through the supervisor; standalone
// workflows can leave graphRunId null.
model WorkflowRun {
  id          String            @id @default(cuid())
  orgId       String
  org         Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  templateId  String
  template    WorkflowTemplate  @relation(fields: [templateId], references: [id])
  graphRunId  String?           @unique
  // Verbatim input values supplied at start time, after schema validation.
  input       Json
  status      WorkflowRunStatus @default(RUNNING)
  // Final state snapshot once the run completes; null while in-flight.
  output      Json?
  error       String?
  startedBy   String?
  startedAt   DateTime          @default(now())
  completedAt DateTime?

  @@index([orgId])
  @@index([orgId, status])
  @@index([templateId])
  @@index([orgId, startedAt])
}

// Tracks intended/scheduled meetings produced by the agent pipeline OR
// logged manually by humans. Phase 2.5: agents never write to external
// calendars directly — they create PROPOSED rows here, a human reviews
// and confirms, and the user replicates in their actual calendar. The
// ledger is the source of truth the dashboard reads from.
model MeetingLedger {
  id                 String               @id @default(cuid())
  orgId              String
  org                Org                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Optional link to the outreach artifact that produced this meeting
  // proposal. Null for manually-logged meetings.
  outreachArtifactId String?
  // Optional durable thread/message provenance. Composite keys make it
  // impossible to attach a meeting to another tenant's conversation.
  conversationId     String?
  conversation       Conversation?        @relation(fields: [conversationId, orgId], references: [id, orgId], onDelete: NoAction)
  sourceMessageId    String?
  sourceMessage      ConversationMessage? @relation("MeetingSourceMessage", fields: [sourceMessageId, orgId], references: [id, orgId], onDelete: NoAction)
  // Optional link to the lead the meeting is with. Null when the meeting
  // is with someone not (yet) persisted as a Person.
  personId           String?
  title              String
  description        String?
  // Wall-clock UTC. Stored as DateTime so we can sort and filter; the UI
  // is responsible for rendering in the org's timezone.
  scheduledFor       DateTime
  durationMinutes    Int                  @default(30)
  // Verbatim email addresses for attendees. Not FK'd to Person because
  // many attendees are external counterparties whose data we don't store.
  attendeeEmails     String[]
  // Free-form notes from the agent (proposed agenda) or human reviewer.
  notes              String?              @db.Text
  status             MeetingStatus        @default(PROPOSED)
  source             MeetingSource        @default(AGENT_PROPOSED)
  // Who created this row — Clerk user id when human-logged, "agent" for
  // pipeline-proposed entries. Free text by design.
  createdBy          String?
  // Set when status transitions from PROPOSED → CONFIRMED.
  confirmedBy        String?
  confirmedAt        DateTime?
  // Set when status transitions to CANCELLED.
  cancelledReason    String?
  cancelledAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, scheduledFor])
  @@index([outreachArtifactId])
  @@index([conversationId])
  @@index([sourceMessageId])
  @@index([personId])
}

// CAN-SPAM / GDPR e-Privacy suppression list. Audit P0 #3.
//
// Recipients land here when:
//   • They click the one-click List-Unsubscribe URL we stamp on every send.
//   • A provider bounce/complaint webhook marks them undeliverable.
//   • An operator/admin adds them manually.
//
// OutreachSendWorker MUST query this table before any real send and skip
// (status → SUPPRESSED on the artifact, status_reason="suppression_list")
// if the recipient is present. The unsubscribe HMAC URL writes through
// reason=USER_UNSUBSCRIBED.
//
// recipientRef matches OutreachArtifact.recipientRef (raw email, normalized
// to lowercase trim) — kept verbatim rather than hashed so the operator UI
// can show "who is suppressed" without a reverse-index table.
enum OutreachSuppressionReason {
  USER_UNSUBSCRIBED
  BOUNCED
  COMPLAINED
  MANUAL
}

model OutreachSuppression {
  id           String                    @id @default(cuid())
  orgId        String
  org          Org                       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  recipientRef String
  reason       OutreachSuppressionReason @default(USER_UNSUBSCRIBED)
  // Free-text source for audit ("unsubscribe_token", "provider_bounce", etc.).
  source       String?
  // Verbatim user-agent / IP / provider event id, retained for audit trail.
  // Kept minimal — no full request bodies, no PII beyond what the recipient
  // already supplied by clicking unsubscribe.
  metadata     Json?
  createdAt    DateTime                  @default(now())

  @@unique([orgId, recipientRef])
  @@index([orgId, createdAt])
}
