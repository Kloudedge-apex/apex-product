}

// ─── Models ──────────────────────────────────────────────

model Org {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  website              String? // company homepage URL (e.g. "acme.com") — used for auto-ICP generation
  plan                 Plan                  @default(TRIAL)
  trialEndsAt          DateTime?
  billingId            String? // Razorpay subscription ID
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  users                User[]
  agents               Agent[]
  integrations         Integration[]
  runs                 AgentRun[]
  icpProfiles          IcpProfile[]
  companies            Company[]
  leadScores           LeadScore[]
  scrapeJobs           ScrapeJob[]
  graphRuns            GraphRun[]
  outreachArtifacts    OutreachArtifact[]
  workflowRuns         WorkflowRun[]
  meetings             MeetingLedger[]
  evidenceEvents       EvidenceEvent[]
  conversations        Conversation[]
  replies              Reply[]
  emailEvents          EmailEvent[]
  emailMessages        EmailMessage[]
  suppressions         SuppressionEntry[]
  enrichmentFacts      EnrichmentFact[]
  llmRequestFacts      LlmRequestFact[]
  orgHourlyUsage       OrgHourlyUsage[]
  orgDailyUsage        OrgDailyUsage[]
  evaluatorRuns        EvaluatorRun[]
  goldenSetExamples    GoldenSetExample[]
  replyClassifications ReplyClassification[]

  @@index([slug])
}

model EvidenceEvent {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  runId     String?
  traceId   String?
  kind      String
  refType   String
  refId     String
  payload   Json
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, kind])
  @@index([runId])
  @@map("evidence_event")
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  org          Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email        String   @unique
  name         String?
  role         UserRole @default(MEMBER)
  clerkId      String?  @unique
  apiKey       String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())

  @@index([orgId])
  @@index([clerkId])
  @@index([apiKey])
}

model AgentTemplate {
  id                   String   @id @default(cuid())
  domain               Domain
  name                 String   @unique
  description          String
  systemPrompt         String?  @db.Text
  defaultConfig        Json
  requiredIntegrations String[] // e.g. ["email", "crm"]
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  agents               Agent[]

  @@index([domain])
  @@index([isActive])
}

model Agent {
  id               String                 @id @default(cuid())
  orgId            String
  org              Org                    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  templateId       String
  template         AgentTemplate          @relation(fields: [templateId], references: [id])
  name             String
  domain           Domain
  config           Json
  schedule         String? // Cron expression
  status           AgentStatus            @default(PAUSED)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  runs             AgentRun[]
  memories         AgentMemory[]
  memoryEmbeddings AgentMemoryEmbedding[]

  @@index([orgId])
  @@index([orgId, domain])
  @@index([orgId, status])
  @@index([templateId])
}

model Integration {
  id                   String            @id @default(cuid())
  orgId                String
  org                  Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider             String // gmail, outlook, hubspot, linkedin, etc
  credentials          Json // Encrypted JSON blob
  encryptedCredentials String?           @db.Text // AES-256-GCM encrypted token string
  status               IntegrationStatus @default(PENDING)
  scopes               String[] // OAuth scopes granted
  lastSyncAt           DateTime?
  lastErrorAt          DateTime?
  lastErrorMessage     String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([orgId, provider])
  @@index([orgId])
  @@index([orgId, provider])
  @@index([status])
}

model AgentRun {
  id               String            @id @default(cuid())
  agentId          String
  agent            Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  orgId            String
  org              Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  startedAt        DateTime          @default(now())
  completedAt      DateTime?
  status           RunStatus         @default(RUNNING)
  result           Json?
  tokensUsed       Int               @default(0)
  cost             Float             @default(0)
  requiresApproval Boolean           @default(false)
  approvedAt       DateTime?
  approvedBy       String? // Clerk user ID of the approver
  logs             AgentLog[]
  steps            RunStep[]
  toolReceipts     ToolCallReceipt[]

  @@index([agentId])
  @@index([orgId])
  @@index([orgId, status])
  @@index([agentId, startedAt])
  @@index([startedAt])
}

/**
 * Idempotency record for side-effecting tool calls (send_email, hubspot, etc.).
 * Keyed on (runId, toolName, inputHash) — if a run is replayed (worker crash,
 * BullMQ retry), the executor finds an existing receipt and returns the
 * persisted output instead of re-invoking the tool.
 * inputHash is a SHA-256 of a canonical JSON encoding of the tool's input
 * arguments, so semantically-equal inputs collide and dedupe.
 */
model ToolCallReceipt {
  id        String   @id @default(cuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  orgId     String
  toolName  String
  inputHash String
  output    Json
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([runId, toolName, inputHash])
  @@index([orgId, toolName])
}

model AgentLog {
  id        String   @id @default(cuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  level     LogLevel
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([runId])
  @@index([runId, level])
  @@index([createdAt])
}

model RunStep {
  id         String      @id @default(cuid())
  runId      String
  run        AgentRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepIndex  Int
  type       RunStepType
  toolName   String?
  input      Json?
  output     Json?
  durationMs Int         @default(0)
  tokenCount Int         @default(0)
  error      String?
  createdAt  DateTime    @default(now())

  @@index([runId])
  @@index([runId, stepIndex])
  @@index([runId, type])
}

model AgentMemory {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, key])
  @@index([agentId])
}

/**
 * Semantic memory entries (pgvector-backed). Each row stores a chunk of
 * free-form text plus its embedding so the executor can retrieve top-K
 * relevant memories at run start instead of dumping every key into the prompt.
 * The `embedding` column is declared as Unsupported because Prisma doesn't
 * model the pgvector type natively. Reads/writes go through $queryRaw /
 * $executeRaw in MemoryService.
 */
model AgentMemoryEmbedding {
  id        String                      @id @default(cuid())
  agentId   String
  agent     Agent                       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  content   String                      @db.Text
  embedding Unsupported("vector(3072)")
  metadata  Json?
  createdAt DateTime                    @default(now())

  @@index([agentId])
}

