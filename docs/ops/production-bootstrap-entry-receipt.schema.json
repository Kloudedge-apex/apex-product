        "outreachIdempotencyDuplicateGroups": { "const": 0 },
        "legacyGmailReplySequenceStopRows": { "$ref": "#/$defs/nonnegativeInteger" },
        "managerRoleRows": { "const": 0 },
        "graphRunRunningRows": { "const": 0 },
        "graphRunAwaitingApprovalRows": { "$ref": "#/$defs/nonnegativeInteger" },
        "graphActiveOrgDuplicateGroups": { "const": 0 },
        "graphActiveWithoutRecoveryStateRows": { "const": 0 },
        "graphLifecycleSchemaReady": { "const": false },
        "replySchemaReady": { "type": "boolean" },
        "replySourceDuplicateGroups": { "type": ["integer", "null"], "minimum": 0 },
        "replyConversationDuplicateGroups": { "type": ["integer", "null"], "minimum": 0 },
        "nullSourceReplyRows": { "type": ["integer", "null"], "minimum": 0 },
        "replySlotDuplicateRows": { "type": ["integer", "null"], "minimum": 0 },
        "duplicateInventoryEvidenceHash": { "$ref": "#/$defs/sha256" },
        "clerkIdentitySchemaReady": { "const": false },
        "clerkCutoverRowCount": { "const": null },
        "clerkCutoverReady": { "const": null },
        "clerkMinimumEventVersion": { "const": null },
        "clerkInventoryEvidenceHash": { "const": null },
        "clerkExpectedActiveOrganizationCount": { "const": null },
        "clerkExpectedActiveMembershipCount": { "const": null },
        "clerkExpectedActiveUserCount": { "const": null },
        "clerkActiveOrganizationCount": { "const": null },
        "clerkActiveMembershipCount": { "const": null },
        "clerkActiveUserCount": { "const": null },
        "clerkProjectionMismatchRows": { "const": null },
        "clerkOrphanActiveAuthorityRows": { "const": null },
        "clerkReadinessViolationCount": { "const": null }
      },
      "allOf": [
        {
          "if": { "properties": { "replySchemaReady": { "const": false } } },
          "then": {
            "properties": {
              "replySourceDuplicateGroups": { "const": null },
              "replyConversationDuplicateGroups": { "const": null },
              "nullSourceReplyRows": { "const": null },
              "replySlotDuplicateRows": { "const": null }
            }
          },
          "else": {
            "properties": {
              "replySourceDuplicateGroups": { "const": 0 },
              "replyConversationDuplicateGroups": { "const": 0 },
              "nullSourceReplyRows": { "const": 0 },
              "replySlotDuplicateRows": { "const": 0 }
            }
          }
        }
      ]
