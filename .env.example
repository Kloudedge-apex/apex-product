# Database
DATABASE_URL="postgresql://apex:apex_dev_password@localhost:5432/apex?schema=public"

# Encryption (32-byte hex key for AES-256-GCM credential encryption)
ENCRYPTION_KEY=""

# Redis (optional - in-memory queue used if not set)
REDIS_URL="redis://localhost:6379"

# Worker process gating (must be set on worker container apps)
WORKER_ENABLED=""                      # "true" to enable legacy in-memory poll workers
OUTREACH_WORKER_ENABLED=""             # "true" to enable BullMQ-backed outreach send worker
GRAPH_RUN_WORKER_ENABLED=""            # "true" to enable the GraphRun durability + crash-recovery sweep worker
LEGACY_TRIGGER_DISCOVERY_ENABLED=""    # default OFF — opt back into POST /leads/discover (graph supervisor is canonical)

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_DOMAIN=""                        # e.g. your-app.clerk.accounts.dev (for JWT verification)
CLERK_JWKS_URL=""                      # Optional: override JWKS endpoint
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# Razorpay Billing
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# OAuth - Gmail (optional, app works with mock data if not set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/integrations/gmail/callback"

# Gmail Pub/Sub push (required for inbound-message webhooks)
GMAIL_PUSH_AUDIENCE=""                 # Exact push URL (e.g. https://api.example.com/api/integrations/gmail/push)
GMAIL_PUSH_PUBLISHER_SA=""             # Pub/Sub OIDC identity (e.g. gmail-push-publisher@PROJECT.iam.gserviceaccount.com)
GMAIL_PUBSUB_TOPIC=""                  # Fully-qualified topic name (e.g. projects/PROJECT/topics/gmail-inbound)

# OAuth - Outlook (optional)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:4000/api/integrations/outlook/callback"

# OAuth - HubSpot (optional)
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
HUBSPOT_REDIRECT_URI="http://localhost:4000/api/integrations/hubspot/callback"

# OAuth - LinkedIn (optional)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:4000/api/integrations/linkedin/callback"

# LLM (optional - uses realistic mock responses if not set)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""                   # Optional: enables Claude models (claude-3-5-sonnet)
DEFAULT_MODEL=""                       # default gpt-4o-mini — fallback when template doesn't specify
SYSTEM_MODEL_MINI=""                   # default gpt-4o-mini — used by system pipelines (icp-auto, team-page scraper)
LANGSMITH_JUDGE_MODEL=""               # default gpt-4o-mini — model used by evaluator judges

# LangSmith observability (optional - tracing is no-op when LANGSMITH_API_KEY is empty)
LANGSMITH_API_KEY=""
LANGSMITH_TRACING=""                   # "true" to enable, "false" to disable; defaults to enabled when key is set
LANGSMITH_PROJECT=""                   # e.g. "apex-prod" or "apex-dev"
LANGSMITH_CAPTURE_PROMPTS=""           # "true" to include redacted prompt content in traces
LANGSMITH_MAX_CONTENT_CHARS=""         # default 4000

# API
API_PORT=4000
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="https://apex.kloudedge.com"
FRONTEND_URL="http://localhost:3000"

# Azure (Production)
AZURE_CONTAINER_APP_NAME=""
AZURE_RESOURCE_GROUP=""
AZURE_REGISTRY=""
