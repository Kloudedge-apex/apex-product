# Database
DATABASE_URL="postgresql://apex:apex_dev_password@localhost:5432/apex?schema=public"

# Encryption (32-byte hex key for AES-256-GCM credential encryption)
ENCRYPTION_KEY=""

# Redis (optional - in-memory queue used if not set)
REDIS_URL="redis://localhost:6379"

# Worker process gating (must be set on worker container apps)
WORKER_ENABLED=""                      # "true" to enable legacy in-memory poll workers
OUTREACH_WORKER_ENABLED=""             # "true" to enable BullMQ-backed outreach send worker
OUTREACH_FAILED_STATUS_WRITES_ENABLED="false" # Enable only after compatible readers are drained and verified
OUTREACH_FAILED_STATUS_WRITES_ACK=""    # Exact rollout attestation required when FAILED writes are enabled
OUTREACH_DELIVERY_UNKNOWN_WRITE_MODE="disabled" # disabled | first-class
OUTREACH_DELIVERY_UNKNOWN_WRITE_ACK="" # Exact reader and rollback-baseline attestation for first-class writes
OUTREACH_ROLLBACK_COMPATIBILITY_EPOCH="" # Required for first-class delivery-unknown writes
GRAPH_RUN_WORKER_ENABLED=""            # "true" to enable the GraphRun durability + crash-recovery sweep worker
SCHEDULER_ENABLED=""                    # default OFF; cadence scheduling is deferred from guarded-SDR release

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_DOMAIN=""                        # Production release tuple requires this empty; local fallback only
CLERK_JWKS_URL=""                      # Production value is exact and source-pinned; local override otherwise
CLERK_ISSUER=""                        # Production value is exact and source-pinned; local derivation otherwise
CLERK_AUTHORIZED_PARTIES=""             # Required in prod and source-pinned; comma-separated exact JWT azp origins
CLERK_AUDIENCE=""                       # Production tuple currently pins empty; review before enabling an audience
CLERK_WEBHOOK_SECRET=""                 # Required in production; verifies Clerk/Svix auth webhooks
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# Razorpay Billing
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# OAuth - Gmail (OAuth and all three Gmail push values are required in production;
# development without a client id uses the explicit mock callback path)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/integrations/gmail/callback"

# Gmail Pub/Sub push (required by production API and worker startup)
GMAIL_PUSH_AUDIENCE=""                 # Exact push URL (e.g. https://api.example.com/api/integrations/gmail/push)
GMAIL_PUSH_PUBLISHER_SA=""             # Pub/Sub OIDC identity (e.g. gmail-push-publisher@PROJECT.iam.gserviceaccount.com)
GMAIL_PUBSUB_TOPIC=""                  # Fully-qualified topic name (e.g. projects/PROJECT/topics/gmail-inbound)

# OAuth - Outlook (optional)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:4000/api/integrations/outlook/callback"

# OAuth - HubSpot (optional)
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
HUBSPOT_REDIRECT_URI="http://localhost:4000/api/integrations/hubspot/callback"

# OAuth - LinkedIn (optional)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:4000/api/integrations/linkedin/callback"

# LLM (optional - uses realistic mock responses if not set)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""                   # Optional: enables Claude models (claude-3-5-sonnet)
DEFAULT_MODEL=""                       # default gpt-4o-mini — fallback when template doesn't specify
SYSTEM_MODEL_MINI=""                   # default gpt-4o-mini — used by system pipelines (icp-auto, team-page scraper)
LANGSMITH_JUDGE_MODEL=""               # default gpt-4o-mini — model used by evaluator judges

# LangSmith observability (optional - tracing is no-op when LANGSMITH_API_KEY is empty)
LANGSMITH_API_KEY=""
LANGSMITH_TRACING=""                   # "true" to enable, "false" to disable; defaults to enabled when key is set
LANGSMITH_PROJECT=""                   # e.g. "apex-prod" or "apex-dev"
LANGSMITH_CAPTURE_PROMPTS=""           # "true" to include redacted prompt content in traces
LANGSMITH_MAX_CONTENT_CHARS=""         # default 4000

# API
API_PORT=4000
API_URL="http://localhost:4000"
REQUIRE_PRODUCTION_ENV=""               # set "true" on every deployed API/worker revision
ADMIN_API_KEY=""                        # required when REQUIRE_PRODUCTION_ENV=true
METRICS_AUTH_TOKEN=""                   # optional locally; required via secretRef on both production roles
CORS_ALLOWED_ORIGINS=""                 # required in production; comma-separated exact browser origins
HEALTH_CHECK_TIMEOUT_MS=2000             # bounds Postgres/Redis readiness and worker-stat probes
# Public origin stamped into visible and RFC 8058 unsubscribe links.
# Required in production; must be a public HTTPS origin (optional trailing /api).
API_PUBLIC_URL="http://localhost:4000"
# Optional dedicated signing secret. When unset, a domain-separated key is
# derived from ENCRYPTION_KEY; keep either source stable so old links remain valid.
UNSUBSCRIBE_HMAC_SECRET=""
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="https://apex.kloudedge.com"
FRONTEND_URL="http://localhost:3000"

# Azure (Production)
AZURE_CONTAINER_APP_NAME=""
AZURE_RESOURCE_GROUP=""
AZURE_REGISTRY=""
