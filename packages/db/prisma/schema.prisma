  OPERATIONS
  HR
  LEGAL
  EXECUTIVE
  OTHER
  UNKNOWN
}

enum EmailSource {
  TEAM_PAGE
  GITHUB_COMMIT
  PATTERN_GUESS
  HUNTER
  SEC_FILING
  PRESS_RELEASE
}

enum VerificationResult {
  VALID
  INVALID
  CATCH_ALL
  UNKNOWN
}

