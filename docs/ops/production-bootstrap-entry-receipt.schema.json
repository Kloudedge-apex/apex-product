        "expectedActiveOrganizationCount",
        "expectedActiveMembershipCount",
        "expectedActiveUserCount",
        "executor",
        "dryRunPassed",
        "approver",
        "planSignatureSha256",
        "signatureNamespace",
        "independentApprovalEvidenceHash",
        "verifiedAt",
        "expiresAt"
      ],
      "properties": {
