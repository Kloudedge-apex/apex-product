generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─── Enums ───────────────────────────────────────────────

enum Plan {
  TRIAL
  STARTER
  GROWTH
  ENTERPRISE
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

enum Domain {
  SALES
  MARKETING
  OPS
}

enum AgentStatus {
  ACTIVE
  PAUSED
  ERROR
  DEPLOYING
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  ERROR
  REVOKED
}

enum RunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  PENDING_APPROVAL
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum RunStepType {
  LLM_CALL
  TOOL_CALL
  TOOL_RESULT
  ERROR
  FINAL_OUTPUT
}

enum GraphRunStatus {
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum OutreachArtifactStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SENT
  // Recipient is on the OutreachSuppression list — worker skipped real send.
  // Terminal state, same shape as REJECTED for UI purposes but produced by
  // the system (CAN-SPAM compliance), not by a human reviewer.
  SUPPRESSED
  // Claim state: a send worker CAS'd the row from APPROVED before dispatch so
  // concurrent workers cannot double-send. Released back to APPROVED only
  // when no provider attempt or a provider-rejected response is proven. A
  // stale claim is terminal DELIVERY_UNKNOWN because process death cannot
  // prove whether the provider accepted the request.
  // NOTE: SENDING/SIMULATED/DELIVERY_UNKNOWN/FAILED are appended at the end of the
  // enum to mirror the ALTER TYPE … ADD VALUE migrations (keeps prod and
  // schema.prisma value order in sync for drift checks).
  SENDING
  // Terminal state for forced-mock sends (org not in OUTREACH_LIVE_FOR_ORGS).
  // The mock_ receipt is kept for the audit trail, but dashboards/KPIs must
  // never count SIMULATED traffic as delivered mail — that is the whole point
  // of splitting it off SENT.
  SIMULATED
  // Terminal safety state: a live provider request may have been accepted,
  // but no trustworthy response/receipt reached the worker, or a SENDING
  // claim went stale after process loss. Automatic dispatch is permanently
  // disabled for this artifact; an operator must reconcile provider state
  // before deciding whether a separately reviewed replacement is warranted.
  DELIVERY_UNKNOWN
  // Terminal dispatch failure after retry exhaustion where provider
  // acceptance is known to be impossible (pre-dispatch failure or explicit
  // provider rejection). This is operational truth, not a human rejection;
  // the worker never retries this artifact automatically.
  FAILED
}

enum OutreachChannel {
  EMAIL
  LINKEDIN
  HUBSPOT_NOTE
}

enum WorkflowRunStatus {
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum MeetingStatus {
  PROPOSED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum MeetingSource {
  AGENT_PROPOSED
  HUMAN_LOGGED
  IMPORTED
}

enum ConversationDirection {
  INBOUND
  OUTBOUND
}

enum ConversationSentiment {
  POSITIVE
  OBJECTION
  NEUTRAL
  NEGATIVE
}

enum ConversationNextActionType {
  SEND_CONTENT
  QUALIFY
  DISQUALIFY
  FOLLOW_UP
}

enum ConversationIntelligenceStatus {
  PENDING
  READY
  FAILED
}

enum FollowUpStatus {
  OPEN
  DONE
  CANCELLED
}

enum FollowUpSource {
  HUMAN
  AGENT
}

enum OutreachArtifactPurpose {
  OUTBOUND
  REPLY
  FOLLOW_UP
}

// ─── Models ──────────────────────────────────────────────

model Org {
  id                   String                @id @default(cuid())
  // Immutable Clerk Organization identity. Nullable for local trial workspaces
  // created while Clerk Organizations is disabled; never infer this from slug.
  clerkOrgId           String?               @unique
  name                 String
  slug                 String                @unique
  website              String? // company homepage URL (e.g. "acme.com") — used for auto-ICP generation
  // CAN-SPAM §7704(a)(5) compliance: every outbound commercial email must
  // include the sender's valid physical postal mailing address. The send
  // worker appends these as a footer; ship-time enforcement (block
  // APPROVED → SENT when physicalAddress is null) is a follow-up gate.
  physicalAddress      String?
  country              String?
  senderName           String?
  plan                 Plan                  @default(TRIAL)
  trialEndsAt          DateTime?
  billingId            String? // Razorpay subscription ID
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  users                User[]
  agents               Agent[]
  integrations         Integration[]
  runs                 AgentRun[]
  icpProfiles          IcpProfile[]
  companies            Company[]
  leadScores           LeadScore[]
  scrapeJobs           ScrapeJob[]
  graphRuns            GraphRun[]
  outreachArtifacts    OutreachArtifact[]
  workflowRuns         WorkflowRun[]
  meetings             MeetingLedger[]
  evidenceEvents       EvidenceEvent[]
  outreachSuppressions OutreachSuppression[]
  conversations        Conversation[]
  conversationMessages ConversationMessage[]
  followUpTasks        FollowUpTask[]

  @@index([slug])
}

model EvidenceEvent {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  runId     String?
  traceId   String?
  kind      String
  refType   String
  refId     String
  payload   Json
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, kind])
  @@index([runId])
  @@map("evidence_event")
}

model User {
  id                String   @id @default(cuid())
  orgId             String
  org               Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email             String   @unique
  name              String?
  role              UserRole @default(MEMBER)
  clerkId           String?  @unique
  // Current immutable Clerk join lifecycle. Historical lifecycle tombstones
  // live in ClerkMembershipLifecycle so an older id can never be replayed.
  clerkMembershipId String?  @unique
  // Fail closed for legacy rows until the release operator reconciles them.
  // Every application-owned create path sets this explicitly.
  membershipActive  Boolean  @default(false)
  apiKey            String?  @unique
  passwordHash      String?
  createdAt         DateTime @default(now())

  @@index([orgId])
  @@index([clerkId])
  @@index([apiKey])
}

// Provider-owned lifecycle cursors. These records are intentionally detached
// from local cascading relations: deleting a local projection must never erase
// the tombstone that rejects an old Clerk webhook replay.
model ClerkIdentityCutover {
  id                              Int      @id
  minimumEventVersion             BigInt
  ready                           Boolean  @default(false)
  inventoryEvidenceHash           String?
  expectedActiveOrganizationCount Int      @default(-1)
  expectedActiveMembershipCount   Int      @default(-1)
  expectedActiveUserCount         Int      @default(-1)
  establishedAt                   DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  @@map("clerk_identity_cutover")
}

model ClerkOrganizationLifecycle {
  clerkOrgId   String   @id
  eventVersion BigInt
  eventRank    Int
  deleted      Boolean  @default(false)
  lastEventId  String
  updatedAt    DateTime @updatedAt

  @@map("clerk_organization_lifecycle")
}

model ClerkMembershipLifecycle {
  clerkMembershipId String   @id
  clerkUserId       String
  clerkOrgId        String
  eventVersion      BigInt
  eventRank         Int
  role              UserRole
  deleted           Boolean  @default(false)
  lastEventId       String
  updatedAt         DateTime @updatedAt

  @@index([clerkUserId])
  @@index([clerkOrgId])
  @@map("clerk_membership_lifecycle")
}

model ClerkUserLifecycle {
  clerkUserId            String   @id
  deleted                Boolean  @default(false)
  clerkMembershipId      String?
  clerkOrgId             String?
  membershipEventVersion BigInt?
  membershipEventRank    Int?
  membershipActive       Boolean  @default(false)
  role                   UserRole @default(MEMBER)
  lastEventId            String
  updatedAt              DateTime @updatedAt

  @@index([clerkMembershipId])
  @@index([clerkOrgId])
  @@map("clerk_user_lifecycle")
}

model AgentTemplate {
  id                   String   @id @default(cuid())
  domain               Domain
  name                 String   @unique
  description          String
  systemPrompt         String?  @db.Text
  defaultConfig        Json
  requiredIntegrations String[] // e.g. ["email", "crm"]
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  agents               Agent[]

  @@index([domain])
  @@index([isActive])
}

model Agent {
  id               String                 @id @default(cuid())
  orgId            String
  org              Org                    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  templateId       String
  template         AgentTemplate          @relation(fields: [templateId], references: [id])
  name             String
  domain           Domain
  config           Json
  schedule         String? // Cron expression
  status           AgentStatus            @default(PAUSED)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  runs             AgentRun[]
  memories         AgentMemory[]
  memoryEmbeddings AgentMemoryEmbedding[]

  @@index([orgId])
  @@index([orgId, domain])
  @@index([orgId, status])
  @@index([templateId])
}

model Integration {
  id                   String            @id @default(cuid())
  orgId                String
  org                  Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider             String // gmail, outlook, hubspot, linkedin, etc
  credentials          Json // Encrypted JSON blob
  encryptedCredentials String?           @db.Text // AES-256-GCM encrypted token string
  status               IntegrationStatus @default(PENDING)
  scopes               String[] // OAuth scopes granted
  lastSyncAt           DateTime?
  lastErrorAt          DateTime?
  lastErrorMessage     String?
  // Gmail push watermark: last Gmail historyId processed for this org's
  // mailbox. Persists the in-memory HISTORY_WATERMARK map in
  // integrations/gmail/gmail.service.ts so history dedup survives process
  // restarts. Null means "no watermark yet — scan from the pushed historyId".
  lastHistoryId        String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  conversations        Conversation[]

  @@unique([orgId, provider])
  // Composite ownership key used by Conversation's tenant-safe FK. The id is
  // already globally unique; this second key lets Postgres prove that an
  // integration and conversation carry the same orgId.
  @@unique([id, orgId])
  @@index([orgId])
  @@index([orgId, provider])
  @@index([status])
}

model AgentRun {
  id               String            @id @default(cuid())
  agentId          String
  agent            Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  orgId            String
  org              Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  startedAt        DateTime          @default(now())
  completedAt      DateTime?
  status           RunStatus         @default(RUNNING)
  result           Json?
  tokensUsed       Int               @default(0)
  cost             Float             @default(0)
  requiresApproval Boolean           @default(false)
  approvedAt       DateTime?
  approvedBy       String? // Clerk user ID of the approver
  logs             AgentLog[]
  steps            RunStep[]
  toolReceipts     ToolCallReceipt[]

  @@index([agentId])
  @@index([orgId])
  @@index([orgId, status])
  @@index([agentId, startedAt])
  @@index([startedAt])
}

/**
 * Idempotency record for side-effecting tool calls (send_email, hubspot, etc.).
 * Keyed on (runId, toolName, inputHash) — if a run is replayed (worker crash,
 * BullMQ retry), the executor finds an existing receipt and returns the
 * persisted output instead of re-invoking the tool.
 * inputHash is a SHA-256 of a canonical JSON encoding of the tool's input
 * arguments, so semantically-equal inputs collide and dedupe.
 */
model ToolCallReceipt {
  id        String   @id @default(cuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  orgId     String
  toolName  String
  inputHash String
  output    Json
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([runId, toolName, inputHash])
  @@index([orgId, toolName])
}

model AgentLog {
  id        String   @id @default(cuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  level     LogLevel
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([runId])
  @@index([runId, level])
  @@index([createdAt])
}

model RunStep {
  id         String      @id @default(cuid())
  runId      String
  run        AgentRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepIndex  Int
  type       RunStepType
  toolName   String?
  input      Json?
  output     Json?
  durationMs Int         @default(0)
  tokenCount Int         @default(0)
  error      String?
  createdAt  DateTime    @default(now())

  @@index([runId])
  @@index([runId, stepIndex])
  @@index([runId, type])
}

model AgentMemory {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, key])
  @@index([agentId])
}

/**
 * Semantic memory entries (pgvector-backed). Each row stores a chunk of
 * free-form text plus its embedding so the executor can retrieve top-K
 * relevant memories at run start instead of dumping every key into the prompt.
 * The `embedding` column is declared as Unsupported because Prisma doesn't
 * model the pgvector type natively. Reads/writes go through $queryRaw /
 * $executeRaw in MemoryService.
 */
model AgentMemoryEmbedding {
  id        String                      @id @default(cuid())
  agentId   String
  agent     Agent                       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  content   String                      @db.Text
  embedding Unsupported("vector(3072)")
  metadata  Json?
  createdAt DateTime                    @default(now())

  @@index([agentId])
}

