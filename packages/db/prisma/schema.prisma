// 10-label canonical intent set. Order and spelling are load-bearing
// for the classifier prompts and the eval golden set. Do not add
// synonyms or coarse POSITIVE/NEGATIVE buckets here.
enum ReplyIntent10 {
  positive_interest
  question_or_objection
  referral
  not_now
  wrong_person
  unsubscribe
  negative_not_interested
  auto_reply_ooo
  bounce_or_ndr
  spam_or_legal_threat
}

enum SuppressionScope {
  GLOBAL
  ORG
  SENDER
  THREAD
}

enum SuppressionKind {
  UNSUBSCRIBE
  COMPLAINT
  HARD_BOUNCE
  SPAM_TRAP
  LEGAL
  CRM_INACTIVE
  MANUAL
  THREAD_HUMAN_REPLY
  OOO_COOLDOWN
}

enum EnrichmentLicenseScope {
  INTERNAL_ONLY // paid APIs we cannot share or train on across tenants
  RESEARCH_OK // public scrape, usable for internal research / eval
  SHAREABLE_AGGREGATE // aggregable into anonymized cross-tenant benchmarks
}

enum EvaluatorTargetType {
  ARTIFACT
  REPLY
  CLASSIFICATION
  ENRICHMENT
}

enum LlmRequestStatus {
  OK
  ERROR
  TIMEOUT
  CANCELLED
}

enum GoldenSetSource {
  PROMOTED_SENT
  HUMAN_AUTHORED
  ADVERSARIAL
