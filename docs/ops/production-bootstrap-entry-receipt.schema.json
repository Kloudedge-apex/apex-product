        "uncertainApplicationWriters": { "$ref": "#/$defs/nonnegativeInteger" },
        "uncertainComplianceWriters": { "$ref": "#/$defs/nonnegativeInteger" },
        "tokenSetHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "orphanRecoveryZeroTokenState": {
      "allOf": [
        { "$ref": "#/$defs/orphanRecoveryTokenState" },
        { "properties": {
          "activeApplicationWriters": { "const": 0 },
          "activeComplianceWriters": { "const": 0 },
          "uncertainApplicationWriters": { "const": 0 },
          "uncertainComplianceWriters": { "const": 0 }
        } }
      ]
    },
    "orphanRecovery": {
      "type": "object",
      "additionalProperties": false,
