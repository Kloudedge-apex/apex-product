        "stateHash": { "$ref": "#/$defs/sha256" },
        "activeWriters": { "const": 0 },
        "activeComplianceWriters": { "const": 0 },
        "writerZero": { "const": true }
      }
    },
    "orphanRecoveryTokenState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activeApplicationWriters", "activeComplianceWriters",
