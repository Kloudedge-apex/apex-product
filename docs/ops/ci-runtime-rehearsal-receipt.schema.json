{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workforce-os.example/schemas/ci-runtime-rehearsal-receipt.schema.json",
  "title": "Workforce OS synthetic CI runtime rehearsal receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environment",
    "authority",
    "status",
    "candidateCommit",
    "verifiedAt",
    "image",
    "migrationReceipt",
    "dependencies",
    "roles",
    "consumerRegistration",
    "accessBoundary",
    "shutdown"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "environment": { "const": "ci-synthetic" },
    "authority": { "const": "non-authoritative" },
    "status": { "const": "passed" },
    "candidateCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "verifiedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "migrationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "verified"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "verified": { "const": true }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postgres", "redis"],
      "properties": {
        "postgres": { "const": "ok" },
        "redis": { "const": "ok" }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "worker"],
      "properties": {
        "api": { "$ref": "#/$defs/role" },
        "worker": { "$ref": "#/$defs/role" }
      }
    },
    "consumerRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthy", "queues"],
      "properties": {
        "healthy": { "const": true },
        "queues": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/queue" }
        }
      }
    },
    "accessBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unauthenticatedTenantDenied", "statusCode"],
      "properties": {
        "unauthenticatedTenantDenied": { "const": true },
        "statusCode": { "const": 401 }
      }
    },
    "shutdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutSeconds", "api", "worker"],
      "properties": {
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "api": { "$ref": "#/$defs/shutdown" },
        "worker": { "$ref": "#/$defs/shutdown" }
      }
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liveness", "readiness"],
      "properties": {
        "liveness": { "const": true },
        "readiness": { "const": true }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "workerCount"],
      "properties": {
        "name": {
          "enum": ["graph-runs", "outreach-send"]
        },
        "workerCount": { "type": "integer", "minimum": 1 }
      }
    },
    "shutdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean", "exitCode"],
      "properties": {
        "clean": { "const": true },
        "exitCode": { "enum": [0, 143] }
      }
    }
  }
}
