generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─── Enums ───────────────────────────────────────────────

enum Plan {
  TRIAL
  STARTER
  GROWTH
  ENTERPRISE
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum Domain {
  SALES
  MARKETING
  OPS
}

enum AgentStatus {
  ACTIVE
  PAUSED
  ERROR
  DEPLOYING
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  ERROR
  REVOKED
}

enum RunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  PENDING_APPROVAL
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum RunStepType {
  LLM_CALL
  TOOL_CALL
  TOOL_RESULT
  ERROR
  FINAL_OUTPUT
}

enum GraphRunStatus {
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum OutreachArtifactStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SENT
  // Recipient is on the OutreachSuppression list — worker skipped real send.
  // Terminal state, same shape as REJECTED for UI purposes but produced by
  // the system (CAN-SPAM compliance), not by a human reviewer.
  SUPPRESSED
  // Claim state: a send worker CAS'd the row from APPROVED before dispatch so
  // concurrent workers cannot double-send. Transient — released back to
  // APPROVED on dispatch failure (or by the reconcile sweep when the claiming
  // worker died mid-send).
  // NOTE: SENDING/SIMULATED are appended at the end of the enum to mirror the
  // default ALTER TYPE … ADD VALUE placement in
  // docs/migrations/2026-06-12_week1-hardening-expand.sql (keeps prod and
  // schema.prisma value order in sync for drift checks).
  SENDING
  // Terminal state for forced-mock sends (org not in OUTREACH_LIVE_FOR_ORGS).
  // The mock_ receipt is kept for the audit trail, but dashboards/KPIs must
  // never count SIMULATED traffic as delivered mail — that is the whole point
  // of splitting it off SENT.
  SIMULATED
}

enum OutreachChannel {
  EMAIL
  LINKEDIN
  HUBSPOT_NOTE
}

enum WorkflowRunStatus {
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum MeetingStatus {
  PROPOSED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum MeetingSource {
  AGENT_PROPOSED
  HUMAN_LOGGED
  IMPORTED
}

// ─── Models ──────────────────────────────────────────────

model Org {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  website      String? // company homepage URL (e.g. "acme.com") — used for auto-ICP generation
  // CAN-SPAM §7704(a)(5) compliance: every outbound commercial email must
  // include the sender's valid physical postal mailing address. The send
  // worker appends these as a footer; ship-time enforcement (block
  // APPROVED → SENT when physicalAddress is null) is a follow-up gate.
  physicalAddress String?
  country         String?
  senderName      String?
  plan         Plan          @default(TRIAL)
  trialEndsAt  DateTime?
  billingId    String? // Razorpay subscription ID
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  agents       Agent[]
  integrations Integration[]
  runs         AgentRun[]
  icpProfiles  IcpProfile[]
  companies    Company[]
  leadScores   LeadScore[]
  scrapeJobs   ScrapeJob[]
  graphRuns    GraphRun[]
  outreachArtifacts OutreachArtifact[]
  workflowRuns WorkflowRun[]
  meetings     MeetingLedger[]
  evidenceEvents EvidenceEvent[]
  outreachSuppressions OutreachSuppression[]

  @@index([slug])
}

model EvidenceEvent {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  runId     String?
  traceId   String?
  kind      String
  refType   String
  refId     String
  payload   Json
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, kind])
  @@index([runId])
  @@map("evidence_event")
}

model User {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email     String   @unique
  name      String?
  role         UserRole @default(MEMBER)
  clerkId      String?  @unique
  apiKey       String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())

  @@index([orgId])
  @@index([clerkId])
  @@index([apiKey])
}

model AgentTemplate {
  id                   String   @id @default(cuid())
  domain               Domain
  name                 String   @unique
  description          String
  systemPrompt         String?  @db.Text
  defaultConfig        Json
  requiredIntegrations String[] // e.g. ["email", "crm"]
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  agents               Agent[]

  @@index([domain])
  @@index([isActive])
}

model Agent {
  id         String        @id @default(cuid())
  orgId      String
  org        Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  templateId String
  template   AgentTemplate @relation(fields: [templateId], references: [id])
  name       String
  domain     Domain
  config     Json
  schedule   String? // Cron expression
  status     AgentStatus   @default(PAUSED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  runs              AgentRun[]
  memories          AgentMemory[]
  memoryEmbeddings  AgentMemoryEmbedding[]

  @@index([orgId])
  @@index([orgId, domain])
  @@index([orgId, status])
  @@index([templateId])
}

model Integration {
  id                   String            @id @default(cuid())
  orgId                String
  org                  Org               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider             String // gmail, outlook, hubspot, linkedin, etc
  credentials          Json // Encrypted JSON blob
  encryptedCredentials String?           @db.Text // AES-256-GCM encrypted token string
  status               IntegrationStatus @default(PENDING)
  scopes               String[] // OAuth scopes granted
  lastSyncAt           DateTime?
  lastErrorAt          DateTime?
  lastErrorMessage     String?
  // Gmail push watermark: last Gmail historyId processed for this org's
  // mailbox. Persists the in-memory HISTORY_WATERMARK map in
  // integrations/gmail/gmail.service.ts so history dedup survives process
  // restarts. Null means "no watermark yet — scan from the pushed historyId".
  lastHistoryId        String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([orgId, provider])
  @@index([orgId])
  @@index([orgId, provider])
  @@index([status])
}

model AgentRun {
  id               String     @id @default(cuid())
  agentId          String
  agent            Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  orgId            String
  org              Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  startedAt        DateTime   @default(now())
  completedAt      DateTime?
  status           RunStatus  @default(RUNNING)
  result           Json?
  tokensUsed       Int        @default(0)
  cost             Float      @default(0)
  requiresApproval Boolean    @default(false)
  approvedAt       DateTime?
  approvedBy       String? // Clerk user ID of the approver
  logs             AgentLog[]
  steps            RunStep[]
  toolReceipts     ToolCallReceipt[]

  @@index([agentId])
  @@index([orgId])
  @@index([orgId, status])
  @@index([agentId, startedAt])
  @@index([startedAt])
}

/**
 * Idempotency record for side-effecting tool calls (send_email, hubspot, etc.).
 * Keyed on (runId, toolName, inputHash) — if a run is replayed (worker crash,
 * BullMQ retry), the executor finds an existing receipt and returns the
 * persisted output instead of re-invoking the tool.
 *
 * inputHash is a SHA-256 of a canonical JSON encoding of the tool's input
 * arguments, so semantically-equal inputs collide and dedupe.
 */
model ToolCallReceipt {
  id        String   @id @default(cuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  orgId     String
  toolName  String
  inputHash String
  output    Json
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([runId, toolName, inputHash])
  @@index([orgId, toolName])
}

model AgentLog {
  id        String   @id @default(cuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  level     LogLevel
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([runId])
  @@index([runId, level])
  @@index([createdAt])
}

model RunStep {
  id         String      @id @default(cuid())
  runId      String
  run        AgentRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepIndex  Int
  type       RunStepType
  toolName   String?
  input      Json?
  output     Json?
  durationMs Int         @default(0)
  tokenCount Int         @default(0)
  error      String?
  createdAt  DateTime    @default(now())

  @@index([runId])
  @@index([runId, stepIndex])
  @@index([runId, type])
}

model AgentMemory {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, key])
  @@index([agentId])
}

/**
 * Semantic memory entries (pgvector-backed). Each row stores a chunk of
 * free-form text plus its embedding so the executor can retrieve top-K
 * relevant memories at run start instead of dumping every key into the prompt.
 *
 * The `embedding` column is declared as Unsupported because Prisma doesn't
 * model the pgvector type natively. Reads/writes go through $queryRaw /
 * $executeRaw in MemoryService.
 */
model AgentMemoryEmbedding {
  id        String                       @id @default(cuid())
  agentId   String
  agent     Agent                        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  content   String                       @db.Text
  embedding Unsupported("vector(3072)")
  metadata  Json?
  createdAt DateTime                     @default(now())

  @@index([agentId])
}

// ─── Lead Engine Enums ───────────────────────────────────

enum Seniority {
  C_LEVEL
  VP
  DIRECTOR
  MANAGER
  IC
  UNKNOWN
}

enum Department {
  SALES
  MARKETING
  ENGINEERING
  FINANCE
  OPERATIONS
  HR
  LEGAL
  EXECUTIVE
  OTHER
  UNKNOWN
}

enum EmailSource {
  TEAM_PAGE
  GITHUB_COMMIT
  PATTERN_GUESS
  HUNTER
  SEC_FILING
  PRESS_RELEASE
}

enum VerificationResult {
  VALID
  INVALID
  CATCH_ALL
  UNKNOWN
}

enum ScrapeStage {
  COMPANY_DISCOVERY
  PEOPLE_DISCOVERY
  IDENTITY_RESOLUTION
  CONTACT_ENRICHMENT
  SCORING
}

enum ScrapeStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

// ─── Lead Engine Models ──────────────────────────────────

model IcpProfile {
  id               String      @id @default(cuid())
  orgId            String
  org              Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name             String
  targetTitles     String[]
  targetIndustries String[]
  targetGeos       String[]
  minEmployees     Int?
  maxEmployees     Int?
  techStackSignals String[]
  intentKeywords   String[]
  seedDomains      String[]
  scheduleEnabled  Boolean     @default(false)
  scheduleInterval Int         @default(24)  // hours between runs
  lastRunAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  scrapeJobs       ScrapeJob[]

  @@index([orgId])
  @@index([scheduleEnabled, lastRunAt])
}

model Company {
  id             String   @id @default(cuid())
  orgId          String?
  org            Org?     @relation(fields: [orgId], references: [id], onDelete: SetNull)
  domain         String
  name           String
  industry       String?
  employeeRange  String?
  country        String?
  city           String?
  registryId     String?
  registrySource String?
  fundingStage   String?
  techStack      String[]
  atsProvider    String?
  atsSlug        String?
  teamPageUrl    String?
  raw            Json?
  confidence     Float    @default(0)
  intentScore    Int      @default(0)
  intentSignals  String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  people         Person[]

  @@unique([orgId, domain])
  @@index([domain])
  @@index([country])
  @@index([industry])
}

model Person {
  id            String           @id @default(cuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  title         String?
  seniority     Seniority        @default(UNKNOWN)
  department    Department       @default(UNKNOWN)
  linkedinSlug  String?
  linkedinUrl   String?
  githubHandle  String?
  twitterHandle String?
  location      String?
  bio           String?
  raw           Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  emails        EmailCandidate[]
  scores        LeadScore[]

  @@index([companyId])
  @@index([linkedinSlug])
  @@index([seniority])
}

model EmailCandidate {
  id                 String             @id @default(cuid())
  personId           String
  person             Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  email              String
  pattern            String?
  source             EmailSource
  verified           Boolean            @default(false)
  verificationResult VerificationResult @default(UNKNOWN)
  confidence         Float              @default(0)
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())

  @@unique([personId, email])
  @@index([personId])
}

model PatternStore {
  id          String   @id @default(cuid())
  domain      String   @unique
  patterns    Json
  sampleSize  Int      @default(0)
  lastUpdated DateTime @default(now())
}

model LeadScore {
  id          String    @id @default(cuid())
  orgId       String
  org         Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  personId    String
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  score       Int       @default(0)
  breakdown   Json
  qualifiedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([orgId, personId])
  @@index([orgId])
  @@index([personId])
}

model ScrapeJob {
  id             String       @id @default(cuid())
  orgId          String
  org            Org          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  icpProfileId   String
  icpProfile     IcpProfile   @relation(fields: [icpProfileId], references: [id], onDelete: Cascade)
  stage          ScrapeStage
  status         ScrapeStatus @default(QUEUED)
  source         String?
  totalItems     Int          @default(0)
  processedItems Int          @default(0)
  failedItems    Int          @default(0)
  progress       Float        @default(0)
  metadata       Json?
  startedAt      DateTime?
  completedAt    DateTime?
  error          String?
  createdAt      DateTime     @default(now())

  @@index([orgId])
  @@index([stage])
  @@index([status])
}

// ─── LangGraph runtime ───────────────────────────────────
//
// GraphRun is the high-level run row the application reads from (status,
// current node, approval state, final output). LangGraph's own state for
// resumability lives in GraphCheckpoint / GraphCheckpointWrite, written via
// the PrismaCheckpointSaver (implements BaseCheckpointSaver).

model GraphRun {
  id            String         @id @default(cuid())
  orgId         String
  org           Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  threadId      String         @unique
  graphName     String         // e.g. "pipeline-supervisor"
  status        GraphRunStatus @default(RUNNING)
  currentNode   String?
  state         Json?          // last snapshot of public state (for the UI)
  needsApproval Boolean        @default(false)
  approvedAt    DateTime?
  approvedBy    String?
  error         String?
  startedAt     DateTime       @default(now())
  completedAt   DateTime?
  // LangSmith root run id captured by whichever node makes the first traced
  // LLM call. Persisted (instead of held in an in-memory Map) so a graph that
  // crashes and resumes on a fresh pod can still post run-level feedback for
  // its earlier legs. Nullable: legacy rows and tracing-disabled envs leave it null.
  langsmithRootRunId String?
  outreachArtifacts OutreachArtifact[]

  @@index([orgId])
  @@index([status])
  @@index([orgId, startedAt])
}

model GraphCheckpoint {
  threadId             String
  checkpointNamespace  String   @default("")
  checkpointId         String
  parentCheckpointId   String?
  type                 String?  // serde format hint ("json", "msgpack", etc)
  checkpoint           Bytes    // serialized Checkpoint object
  metadata             Json?
  createdAt            DateTime @default(now())

  @@id([threadId, checkpointNamespace, checkpointId])
  @@index([threadId])
}

// No FK to GraphCheckpoint — LangGraph's PregelLoop can call putWrites with a
// checkpoint_id before put() persists that row (writes are scheduled for the
// upcoming step). A FK would reject those legitimate writes; deletion is
// handled by deleteThread() instead.
model GraphCheckpointWrite {
  threadId            String
  checkpointNamespace String   @default("")
  checkpointId        String
  taskId              String
  idx                 Int
  channel             String
  type                String?
  value               Bytes
  createdAt           DateTime @default(now())

  @@id([threadId, checkpointNamespace, checkpointId, taskId, idx])
  @@index([threadId])
  @@index([threadId, checkpointNamespace, checkpointId])
}

// Reviewable outreach payload generated by the outreach subgraph. Phase 2.5
// runs default to dry-run mode: artifacts are persisted in PENDING_REVIEW
// state and never delivered until a human approves them. The original
// dry-run payload is preserved in `payload` so reviewers see exactly what
// would have been sent; if approved, the worker sends and writes back a
// receipt + provider message id.
model OutreachArtifact {
  id            String                 @id @default(cuid())
  orgId         String
  org           Org                    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  graphRunId    String?
  graphRun      GraphRun?              @relation(fields: [graphRunId], references: [id], onDelete: SetNull)
  // Tool that would have produced the external side effect (e.g. send_email).
  toolName      String
  channel       OutreachChannel
  // Identifies the recipient/account on the outbound side without forcing
  // a hard FK to Person/Company (the graph may produce artifacts for
  // not-yet-persisted leads).
  recipientRef  String?
  subject       String?
  bodyText      String?                @db.Text
  bodyHtml      String?                @db.Text
  // Verbatim tool args captured at the moment of the dry-run, so reviewers
  // see what would have been sent. The shape mirrors the tool's input.
  payload       Json
  status        OutreachArtifactStatus @default(PENDING_REVIEW)
  // Free-text reason from the reviewer when rejecting.
  reviewerNote  String?
  reviewedBy    String?
  reviewedAt    DateTime?
  // Set once the artifact is actually delivered. Together with sendReceiptId
  // these prove a real send happened post-approval.
  sentAt        DateTime?
  sendReceiptId String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([orgId])
  @@index([orgId, status])
  @@index([graphRunId])
  @@index([orgId, createdAt])
}

// A versioned, declarative description of a multi-step workflow. The
// runtime resolves a slug+version to the canonical config (which graph to
// run, which inputs to expect, whether HITL is required). Templates are
// org-agnostic: a single seed row backs every tenant's runs.
model WorkflowTemplate {
  id          String   @id @default(cuid())
  // Stable identifier used by clients to start a workflow (e.g.
  // "tenant_zero_sdr_outreach_artifact_v1"). Unique across versions so a
  // v2 row is a separate template; older runs still resolve to v1.
  slug        String   @unique
  name        String
  description String
  version     Int      @default(1)
  // Name of the graph the runtime should compile to execute this workflow
  // (currently always "pipeline-supervisor"; here so future templates can
  // target alternative graphs without a code change).
  graphName   String
  // Free-form config: input schema, defaults, HITL gates, feature flags.
  // Kept as JSON so the schema doesn't churn with every workflow.
  config      Json
  // Phase 2.5 templates set requiresApproval=true and produce review
  // artifacts only. A v2 release toggles this once policy allows.
  requiresApproval Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs        WorkflowRun[]

  @@index([slug])
  @@index([isActive])
}

// Concrete invocation of a WorkflowTemplate for one org. Maps 1:1 with the
// underlying GraphRun for runs that go through the supervisor; standalone
// workflows can leave graphRunId null.
model WorkflowRun {
  id                String              @id @default(cuid())
  orgId             String
  org               Org                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  templateId        String
  template          WorkflowTemplate    @relation(fields: [templateId], references: [id])
  graphRunId        String?             @unique
  // Verbatim input values supplied at start time, after schema validation.
  input             Json
  status            WorkflowRunStatus   @default(RUNNING)
  // Final state snapshot once the run completes; null while in-flight.
  output            Json?
  error             String?
  startedBy         String?
  startedAt         DateTime            @default(now())
  completedAt       DateTime?

  @@index([orgId])
  @@index([orgId, status])
  @@index([templateId])
  @@index([orgId, startedAt])
}

// Tracks intended/scheduled meetings produced by the agent pipeline OR
// logged manually by humans. Phase 2.5: agents never write to external
// calendars directly — they create PROPOSED rows here, a human reviews
// and confirms, and the user replicates in their actual calendar. The
// ledger is the source of truth the dashboard reads from.
model MeetingLedger {
  id              String         @id @default(cuid())
  orgId           String
  org             Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Optional link to the outreach artifact that produced this meeting
  // proposal. Null for manually-logged meetings.
  outreachArtifactId String?
  // Optional link to the lead the meeting is with. Null when the meeting
  // is with someone not (yet) persisted as a Person.
  personId        String?
  title           String
  description     String?
  // Wall-clock UTC. Stored as DateTime so we can sort and filter; the UI
  // is responsible for rendering in the org's timezone.
  scheduledFor    DateTime
  durationMinutes Int            @default(30)
  // Verbatim email addresses for attendees. Not FK'd to Person because
  // many attendees are external counterparties whose data we don't store.
  attendeeEmails  String[]
  // Free-form notes from the agent (proposed agenda) or human reviewer.
  notes           String?        @db.Text
  status          MeetingStatus  @default(PROPOSED)
  source          MeetingSource  @default(AGENT_PROPOSED)
  // Who created this row — Clerk user id when human-logged, "agent" for
  // pipeline-proposed entries. Free text by design.
  createdBy       String?
  // Set when status transitions from PROPOSED → CONFIRMED.
  confirmedBy     String?
  confirmedAt     DateTime?
  // Set when status transitions to CANCELLED.
  cancelledReason String?
  cancelledAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, scheduledFor])
  @@index([outreachArtifactId])
  @@index([personId])
}

// CAN-SPAM / GDPR e-Privacy suppression list. Audit P0 #3.
//
// Recipients land here when:
//   • They click the one-click List-Unsubscribe URL we stamp on every send.
//   • A provider bounce/complaint webhook marks them undeliverable.
//   • An operator/admin adds them manually.
//
// OutreachSendWorker MUST query this table before any real send and skip
// (status → SUPPRESSED on the artifact, status_reason="suppression_list")
// if the recipient is present. The unsubscribe HMAC URL writes through
// reason=USER_UNSUBSCRIBED.
//
// recipientRef matches OutreachArtifact.recipientRef (raw email, normalized
// to lowercase trim) — kept verbatim rather than hashed so the operator UI
// can show "who is suppressed" without a reverse-index table.
enum OutreachSuppressionReason {
  USER_UNSUBSCRIBED
  BOUNCED
  COMPLAINED
  MANUAL
}

model OutreachSuppression {
  id           String                     @id @default(cuid())
  orgId        String
  org          Org                        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  recipientRef String
  reason       OutreachSuppressionReason  @default(USER_UNSUBSCRIBED)
  // Free-text source for audit ("unsubscribe_token", "provider_bounce", etc.).
  source       String?
  // Verbatim user-agent / IP / provider event id, retained for audit trail.
  // Kept minimal — no full request bodies, no PII beyond what the recipient
  // already supplied by clicking unsubscribe.
  metadata     Json?
  createdAt    DateTime                   @default(now())

  @@unique([orgId, recipientRef])
  @@index([orgId, createdAt])
}
